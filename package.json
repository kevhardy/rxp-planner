{
  "name": "rxp-planner",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --silent data:validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:routing": "vitest run --config integration/vitest.routing.config.ts",
    "test:release": "vitest run --config integration/vitest.release.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/data-contract",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings && stylelint \"**/*.css\" --ignore-path .gitignore --globby-options '{\"dot\":true}'",
    "unused": "knip",
    "links:check": "node scripts/check-links.ts",
    "check": "node scripts/check.ts",
    "import:rxp": "node scripts/guides/import-rxp.ts",
    "data:install": "node scripts/dataset/install.ts",
    "data:validate": "node scripts/dataset/validate.ts",
    "guides:timeline": "node scripts/guides/timeline.ts",
    "guides:opportunities": "node scripts/guides/opportunities.ts",
    "guides:floor-hints": "node scripts/guides/floor-hints.ts",
    "guides:textures": "node scripts/guides/export-textures.ts",
    "contract:build": "pnpm --filter @rxp-planner/data-contract build",
    "contract:check": "node scripts/data-contract/check.ts",
    "agent:mcp": "node scripts/agent/mcp.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "fengari": "^0.1.5",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-plugin-rxpplanner": "workspace:*",
    "oxlint-tsgolint": "7.0.2005",
    "postcss": "^8.5.32",
    "stylelint": "^17.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
